#!/usr/bin/env jaiph

def always_ok() {
  run always_ok_impl()
}

script always_ok_impl = `echo ok`

script noop = `:`

def wf_fail() {
  fail "expected failure"
}

def wf_const() {
  const msg = "hello"
  log "${msg}"
}

def wf_async() {
  run async noop()
}

def wf_brace_if() {
  run always_ok()
  log "then"
}

export def main() {
  run always_ok()
}
