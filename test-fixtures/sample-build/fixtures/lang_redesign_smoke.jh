#!/usr/bin/env jaiph

def always_ok() {
  always_ok_impl()
}

script always_ok_impl = 'echo ok'

script noop = ':'

def wf_fail() {
  fail "expected failure"
}

def wf_const() {
  const msg = "hello"
  log "${msg}"
}

def wf_async() {
  async noop()
}

def wf_brace_if() {
  always_ok()
  log "then"
}

export def main() {
  always_ok()
}
