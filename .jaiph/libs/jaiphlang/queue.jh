#!/usr/bin/env jaiph

#
# Task/queue management.
# Canonical store: ${JAIPH_QUEUE_STATE} or ${JAIPH_WORKSPACE:-.}/.jaiph/queue-state.md
# QUEUE.md and DONE.md are generated views (never parsed after bootstrap).
# Tags are #hashtags in ## headers (e.g. ## My Task #dev-ready).
#
# CLI usage:
#   jaiph .jaiph/libs/jaiphlang/queue.jh headers
#   jaiph .jaiph/libs/jaiphlang/queue.jh get_available
#   jaiph .jaiph/libs/jaiphlang/queue.jh json
#
import script "./queue.py" as queue

export def main(cmd, arg1, arg2) {
  const result = queue(cmd, arg1, arg2)
  log result
}

export def add_tasks_from_file(path) {
  queue("add_from_file", path)
}

export def add_task_from_file(path) {
  queue("add", path)
}

export def get_first_task() {
  return queue("get")
}

export def next_task(tag) {
  return queue("get", tag)
}

export def next_available() {
  return queue("get_available")
}

export def get_task_by_header(header) {
  return queue("get_by_header", header)
}

export def get_all_task_headers() {
  return queue("headers")
}

export def mark_task_dev_ready(header) {
  queue("mark", header, "dev-ready")
}

export def mark_task_in_progress(header) {
  queue("mark", header, "in-progress")
}

export def unmark_task(header, tag) {
  queue("unmark", header, tag)
}

export def remove_completed_task(header) {
  queue("complete_by_header", header)
}

export def archive_to_done(header, notesPath) {
  queue("archive_to_done", header, notesPath)
}

export def set_task_description_from_file(header, bodyPath) {
  queue("set_description", header, bodyPath)
}

export def state_json() {
  return queue("json")
}

export def has_tasks() {
  queue("get")
}

export def task_is_dev_ready(task) {
  queue("has_tag", task, "dev-ready")
}

export def all_dev_ready() {
  queue("check_all_tagged", "dev-ready")
}
