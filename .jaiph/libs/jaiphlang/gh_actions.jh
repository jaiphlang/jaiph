#!/usr/bin/env jaiph

#
# GitHub Actions helpers for Jaiph orchestration workflows.
# Requires: gh, jq, git, and GITHUB_TOKEN granted with --env (this file's
# `use GITHUB_TOKEN`). The script also accepts GH_TOKEN in-process by copying
# GITHUB_TOKEN when GH_TOKEN is unset.
#
# CLI usage:
#   jaiph run --env GITHUB_TOKEN .jaiph/libs/jaiphlang/gh_actions.jh check
#   jaiph run --env GITHUB_TOKEN .jaiph/libs/jaiphlang/gh_actions.jh wait my-branch
#   jaiph run --env GITHUB_TOKEN .jaiph/libs/jaiphlang/gh_actions.jh pull "" abc123 .jaiph/tmp/ci.log
#
import script "./gh_actions.sh" as gh use GITHUB_TOKEN

export def token_set() {
  run gh("require-token")
}

export def check_ci(branch, commit, workflow_name, log_file) {
  return run gh("check-ci", branch, commit, workflow_name, log_file)
}

export def wait_for_ci(branch, commit, workflow_name) {
  return run gh("wait-run", branch, commit, workflow_name)
}

export def pull_logs(branch, commit, workflow_name, out_file, failed_only) {
  return run gh("pull-logs", branch, commit, workflow_name, out_file, failed_only)
}

export def main(cmd, branch, commit, workflow_name, out_file) {
  const result = match cmd {
    "" => run gh("check-ci", branch, commit, workflow_name)
    "check" => run gh("check-ci", branch, commit, workflow_name)
    "wait" => run gh("wait-run", branch, commit, workflow_name)
    "pull" => run gh("pull-logs", branch, commit, workflow_name, out_file, "1")
    _ => fail "Unknown command: ${cmd}. Use: check | wait | pull"
  }
  log result
}
