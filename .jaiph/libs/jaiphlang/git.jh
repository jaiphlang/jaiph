#!/usr/bin/env jaiph

script git_inside_worktree = 'git rev-parse --is-inside-work-tree 2>&1'

script git_porcelain_empty = 'test -z "$(git status --porcelain)"'

script git_porcelain_nonempty = 'test -n "$(git status --porcelain)"'

script git_mark_workspace_safe = 'git config --global --add safe.directory "$(pwd)"'

# Push local HEAD to origin. This is a trusted, deterministic step so the push
# target is controlled by the caller, not by agent output. With an explicit
# branch ($1), force the remote ref (HEAD:refs/heads/<branch>) so the push
# cannot be retargeted by whatever branch happens to be checked out; with no
# branch, push HEAD to its tracking branch (matches `git push -u origin HEAD`).
script git_push_head = '''
  git config --global --add safe.directory "$(pwd)"
  if [ -n "$1" ]; then
    git push -u origin "HEAD:refs/heads/$1"
  else
    git push -u origin HEAD
  fi
'''
export def in_git_repo() {
  git_mark_workspace_safe()
  git_inside_worktree() catch (err) {
    fail "not inside a git repository"
  }
}

export def branch_clean() {
  git_porcelain_empty() catch (err) {
    fail "git working tree is not clean"
  }
}

export def has_changes() {
  git_porcelain_nonempty() catch (err) {
    fail "git working tree has no changes"
  }
}

export def is_clean() {
  in_git_repo()
  branch_clean()
}

export def commit(task) {
  config {
    # agent.backend = "cursor"
    # agent.model = "composer-2"
    # agent.cursor_flags = "--force"
    agent.backend = "claude"
    agent.claude_flags = "--permission-mode bypassPermissions"
  }
  in_git_repo()
  has_changes()

  prompt """
    Please commit current changes.

    Requirements for commit message:
    1. Write a commit message - first line in imperative mood, under 72 chars.
    2. Start with the common prefix like 'Feat:', 'Fix:', 'Refactor:' etc.
    3. Write a body paragraph with more details about the change.

    Requirements for commit:
    1. Review current git changes (git diff --stat, git status).
    2. Stage all relevant changes with git add.
    3. Create exactly one commit.
    4. Do not push.
    5. Remove files that are not relevant to the commit and not git ignored.

    Changes were made for the following task:
    ${task}
  """
}

# Like commit(), but no-ops when the worktree is clean (overnight loops).
export def commit_if_changes(task) {
  has_changes() catch (err) {
    log "No changes to commit."
    return ""
  }
  commit(task)
}

export def push(branch) {
  in_git_repo()
  git_push_head(branch)
}

export def main(task) {
  commit(task)
}
