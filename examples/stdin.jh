#!/usr/bin/env jaiph

# Jaiph streams stdin pipelines so a script can produce a lot of data
# without loading it all into memory. Chain stages with ->.
script gen = '''bash
  printf 'alpha\nbeta\ngamma\n'
'''

script upper = '''bash
  tr 'a-z' 'A-Z'
'''

script count = '''bash
  wc -l | tr -d ' '
'''

export def main() {
  # generate lines -> uppercase them -> reduce to a line count
  const n = stdin gen() -> upper() -> count()
  return n
}
