#!/usr/bin/env jaiph
# Fixture: typed prompt + printf field, same pattern as engineer classify_role.
def classify_like(task) {
  const result = prompt "Classify task \"${task}\" into a single engineer role name (JSON only)." returns "{ role: string }"

  return "${result.role}"
}

# Same pattern as engineer.jh default: capture role from nested workflow.
export def pick_role(task) {
  const role_name = run classify_like(task)
  return "${role_name}"
}

export def main(subject) {
  const chosen = run classify_like(subject)
  log "chosen=${chosen}"
}
