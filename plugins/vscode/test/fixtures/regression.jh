# Regression fixture for stale surface the old extension assumed.
# The grammar test asserts NONE of these get their old (wrong) scopes.
config {
  agent.default_model = "old-key"
  runtime.docker_enabled = true
  runtime.docker_image = "stale"
  runtime.docker_timeout_seconds = 600
}

export def main() {
  # Removed keywords must highlight as plain identifiers, not commands.
  wait for_something
  local
  rule
  workflow
  ensure
  send "payload" -> inbox
}
