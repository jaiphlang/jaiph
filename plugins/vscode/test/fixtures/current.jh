#!/usr/bin/env jaiph
# Grammar fixture: exercises the current .jh language surface.

import "helpers.jh" as helpers
import script "./gh.sh" as gh use GITHUB_TOKEN

config {
  agent.backend = "claude"
  agent.model = "claude-opus"
  run.recover_limit = 3
  module.name = "sample"
}

const REPO = "my-project"

channel alerts
channel findings -> handler

script setup_env = ```bash
mkdir -p out
```

script publish use NPM_TOKEN = `echo x`

prompt analyze(log) use GITHUB_TOKEN = "Look at ${log}"

def check_deps(path) {
  run setup_env()
  return "${path}"
}

export def main(task) {
  script shout use UE_TOKEN = `echo "$1"`
  prompt describe(x) = "Tell me about ${x}"
  def helper(x) {
    return "${x}"
  }
  const status = run setup_env()

  if status == "ok" {
    log "ready"
  } else if status =~ /warn/ {
    logwarn "degraded"
  } else {
    logerr "failed"
  }

  for item in status {
    log item
  }

  run check_deps("package.json") catch (failure) {
    fail "deps missing"
  }

  run setup_env() recover (err) {
    logwarn "retrying"
  }

  run async helpers.scan()

  const answer = prompt "Summarize ${task}" returns "{ risk: string }"
  log "risk: ${answer.risk}"

  send "started" -> alerts
  send run setup_env() -> findings

  const label = match status {
    "ok" => "pass"
    /err/ => "error"
    _ => "unknown"
  }

  return "${label}"
}
